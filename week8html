
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Resume Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        /* Main CSS Grid */
        .dashboard {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 220px 1fr;
            grid-template-rows: 80px 1fr 50px;
            grid-template-areas:
                "head head"
                "side main"
                "foot foot";
            gap: 15px;
            padding: 15px;
        }

        /* Header */
        .header {
            grid-area: head;
            background: #2563eb;
            color: white;
            padding: 25px;
            border-radius: 10px;
        }

        /* Sidebar */
        .sidebar {
            grid-area: side;
            background: #1e293b;
            color: white;
            padding: 20px;
            border-radius: 10px;
        }

        .sidebar ul {
            list-style: none;
            margin-top: 20px;
        }

        .sidebar li {
            margin: 20px 0;
        }

        .sidebar a {
            color: white;
            text-decoration: none;
        }

        /* Main Content */
        .main {
            grid-area: main;
            padding: 10px;
        }

        .intro {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        /* Responsive Cards Grid */
        .cards {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }

        /* Flexbox inside each card */
        .card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #00000010;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .icon {
            font-size: 28px;
        }

        .card h2 {
            font-size: 20px;
            margin-bottom: 12px;
            color: #2563eb;
        }

        .card p {
            margin-bottom: 10px;
            overflow-wrap: anywhere;
        }

        /* Footer */
        .footer {
            grid-area: foot;
            background: #e2e8f0;
            padding: 16px;
            text-align: center;
            border-radius: 10px;
        }

        /* Mobile Responsive Layout */
        @media (max-width: 600px) {
            .dashboard {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto 1fr auto;
                grid-template-areas:
                    "head"
                    "side"
                    "main"
                    "foot";
            }

            .sidebar ul {
                display: flex;
                flex-wrap: wrap;
                gap: 15px;
            }

            .sidebar li {
                margin: 5px 0;
            }
        }
    </style>
</head>

<body>

    <div class="dashboard">

        <!-- Header -->
        <header class="header">
            <h1>My Resume</h1>
        </header>

        <!-- Sidebar -->
        <aside class="sidebar">
            <h2>Mehfooz</h2>
            <p>BTech CSE Section F</p>

            <ul>
                <li><a href="#about">🏠 About Me</a></li>
                <li><a href="#skills">💻 Skills</a></li>
                <li><a href="#education">🎓 Education</a></li>
                <li><a href="#contact">📞 Contact</a></li>
            </ul>
        </aside>

        <!-- Main Area -->
        <main class="main">

            <section class="intro" id="about">
                <h2>Hello! My name is Mehfooz.</h2>
                <br>
                <p>
                    I am a student who is interested in
                    <strong>web development and programming</strong>.
                    I enjoy learning new skills and building websites.
                </p>
            </section>

            <div class="cards">

                <!-- Skills -->
                <section class="card" id="skills">
                    <span class="icon">💻</span>
                    <div>
                        <h2>Skills</h2>
                        <p>HTML5</p>
                        <p>Basic Computer Skills</p>
                        <p>Problem Solving</p>
                    </div>
                </section>

                <!-- Education -->
                <section class="card" id="education">
                    <span class="icon">🎓</span>
                    <div>
                        <h2>Education</h2>
                        <p><strong>University:</strong>
                            Invertis University Bareilly</p>
                        <p><strong>Course:</strong> BTech CSE</p>
                        <p><strong>Year:</strong> First Year</p>
                        <p><strong>Section:</strong> F</p>
                    </div>
                </section>

                <!-- Contact -->
                <section class="card" id="contact">
                    <span class="icon">📞</span>
                    <div>
                        <h2>Contact</h2>
                        <p>Email: mehfoozali84456@gmail.com</p>
                        <p>Location: Bareilly</p>
                    </div>
                </section>

            </div>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <p>© 2026 Mehfooz | My Resume Dashboard</p>
        </footer>

    </div>

</body>
</html>
